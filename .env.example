# ─────────────────────────────────────────────────────────────
#  AEGIS — Environment Configuration Template
#  Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── LLM / Embedding ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Qdrant ───────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                        # Leave blank for local Docker instance

# ── Hermes Agent ─────────────────────────────────────────────
HERMES_HOME=~/.hermes
HERMES_SKILLS_DIR=~/.hermes/skills/aegis

# ── Notification Gateway ─────────────────────────────────────
# Set ONE of the following based on your Hermes gateway config
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ── AEGIS Settings ───────────────────────────────────────────
AEGIS_LOG_LEVEL=INFO
AEGIS_HEARTBEAT_INTERVAL_MINUTES=30
AEGIS_SIMILARITY_THRESHOLD=0.75
AEGIS_MAX_PROACTIVE_NOTIFICATIONS_PER_DAY=10

# ── Dashboard API ────────────────────────────────────────────
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8000
AEGIS_API_CORS_ORIGINS=http://localhost:5173
